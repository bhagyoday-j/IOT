# Environment Variables
NODE_ENV=development
PORT=5000

# ============================================
# OPENROUTER API CONFIGURATION (NEW)
# ============================================
# Your OpenRouter API Key (Get from: https://openrouter.ai/auth/login)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SITE_URL=http://localhost:5000
SITE_NAME=Smart Agriculture IoT

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smart-agriculture
MONGODB_USER=
MONGODB_PASSWORD=

# API Configuration
API_VERSION=v1
API_KEY=your-secret-api-key-for-esp32

# Server Configuration
CORS_ORIGIN=*

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
